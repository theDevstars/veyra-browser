{
  "expo": {
    "name": "Veyra Browser",
    "slug": "veyra-browser",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "scheme": "veyra",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thedevstars.veyra",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choose a wallpaper for Veyra Browser."
      }
    },
    "android": {
      "package": "com.thedevstars.veyra",
      "versionCode": 1
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a wallpaper for Veyra Browser."
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "name": "Veyra Browser",
      "shortName": "Veyra",
      "themeColor": "#17152b",
      "backgroundColor": "#10101a"
    }
  }
}
