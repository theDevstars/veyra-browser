{
  "expo": {
    "name": "Veyra Browser",
    "slug": "veyra-browser",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "scheme": "veyra",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thedevstars.veyra",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choose a wallpaper for Veyra Browser."
      }
    },
    "android": {
      "package": "com.thedevstars.veyra",
      "versionCode": 1
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a wallpaper for Veyra Browser."
        }
      ]
    ]
  }
}
